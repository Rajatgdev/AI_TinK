# Use only a dedicated test Telegram account. Get these from my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Comma-separated numeric IDs of the only chats this prototype may monitor.
# Leave this empty until you have verified the selected test-group IDs.
TELEGRAM_ALLOWED_CHAT_IDS=

# Stored locally after the first successful test-account login. Keep private.
TELEGRAM_SESSION_FILE=.telegram.session

# Local API and database used by the capture pipeline.
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://remember_me:remember_me@localhost:5432/remember_me
PORT=3000

# Used only by the extraction worker. Choose a model enabled for your OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Create this bot with Telegram's @BotFather. Keep the token private.
TELEGRAM_BOT_TOKEN=
# The bot will respond only in these selected test chats during the prototype.
TELEGRAM_BOT_ALLOWED_CHAT_IDS=
# Numeric Telegram IDs allowed to pause capture or delete a memory. The bot will
# tell other group members it cannot perform those caregiver-only actions.
TELEGRAM_CAREGIVER_USER_IDS=

# Optional: enable a daily briefing only after verifying /briefing manually.
# Cron uses five fields: minute hour day-of-month month day-of-week.
DAILY_BRIEFING_CRON=
DAILY_BRIEFING_TIMEZONE=Europe/Dublin

# Active event reminders: checks every minute, starts within 24 hours of an
# event, and repeats until a caregiver marks it done.
REMINDER_CHECK_CRON=* * * * *
REMINDER_LEAD_MINUTES=1440
REMINDER_REPEAT_MINUTES=30

# Local caregiver dashboard only. This is not an Auth0 configuration.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_SELECTED_CHAT_ID=

# Auth0 SPA and API configuration. Domain, client ID, and audience are safe to
# expose to the browser; do not add an Auth0 client secret to this project.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://remember-me-api
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://remember-me-api

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep this private. The listener and bot use it for API-to-API requests.
INTERNAL_API_TOKEN=
