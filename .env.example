# Use only a dedicated test Telegram account. Get these from my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Comma-separated numeric IDs of the only chats this prototype may monitor.
# Leave this empty until you have verified the selected test-group IDs.
TELEGRAM_ALLOWED_CHAT_IDS=

# Stored locally after the first successful test-account login. Keep private.
TELEGRAM_SESSION_FILE=.telegram.session

# Local API and database used by the capture pipeline.
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://remember_me:remember_me@localhost:5432/remember_me
PORT=3000

# Used only by the extraction worker. Choose a model enabled for your OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Create this bot with Telegram's @BotFather. Keep the token private.
TELEGRAM_BOT_TOKEN=
# The bot will respond only in these selected test chats during the prototype.
TELEGRAM_BOT_ALLOWED_CHAT_IDS=
